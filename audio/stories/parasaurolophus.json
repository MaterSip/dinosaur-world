[
  {
    "id": "para-1",
    "text": "叭噗——！聽見我的頭冠喇叭聲了嗎？我是副櫛龍！",
    "startMs": 0,
    "endMs": 6600
  },
  {
    "id": "para-2",
    "text": "我頭上的長長管子就是一把神奇的魔法小號角！",
    "startMs": 6850,
    "endMs": 11890
  },
  {
    "id": "para-3",
    "text": "輕輕一吹，就能呼喚森林裡的同伴一起去喝甘甜泉水喔！",
    "startMs": 12140,
    "endMs": 18428
  }
]